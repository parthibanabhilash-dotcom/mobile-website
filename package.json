{
  "name": "mobile-shop",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "prisma generate && next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate",
    "db:migrate": "tsx scripts/mysql-prisma.ts migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:import:postgresql": "tsx scripts/copy-database.ts",
    "db:copy": "tsx scripts/copy-database.ts",
    "admin:create": "tsx scripts/create-admin.ts",
    "reservations:expire": "tsx scripts/expire-reservations.ts",
    "format": "prettier --write src tests scripts docs README.md",
    "test:performance": "node scripts/lighthouse.mjs",
    "assets:generate": "node scripts/generate-assets.mjs && node scripts/optimize-assets.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.0.0",
    "@prisma/client": "^6.19.0",
    "lucide-react": "^0.468.0",
    "next": "^16.0.0",
    "nodemailer": "^10.0.15",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^3.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@playwright/test": "^1.50.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^7.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "lighthouse": "^13.5.0",
    "pg": "^8.23.1",
    "prettier": "^3.9.9",
    "prisma": "^6.19.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.9.0",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.0"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
