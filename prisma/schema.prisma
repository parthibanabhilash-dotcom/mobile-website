generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id           String      @id @default(cuid())
  email        String      @unique @db.VarChar(255)
  name         String
  passwordHash String
  role         String      @default("CUSTOMER")
  verified     Boolean     @default(false)
  createdAt    DateTime    @default(now())
  sessions     Session[]
  tokens       AuthToken[]
  addresses    Address[]
  carts        CartItem[]
  wishlist     Wishlist[]
  orders       Order[]
  reviews      Review[]
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime

  @@index([expiresAt])
}

model AuthToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  type      String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
}

model Address {
  id      String @id @default(cuid())
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  name    String
  phone   String
  line1   String @db.VarChar(255)
  line2   String @default("") @db.VarChar(255)
  city    String
  state   String
  pincode String
  label   String @default("Home")
}

model Category {
  id       String    @id @default(cuid())
  name     String    @unique
  slug     String    @unique
  products Product[]
}

model Brand {
  id       String    @id @default(cuid())
  name     String    @unique
  slug     String    @unique
  products Product[]
}

model Product {
  id             String         @id @default(cuid())
  slug           String         @unique
  title          String
  subtitle       String         @db.VarChar(255)
  description    String         @db.Text
  warranty       String         @default("1 year manufacturer warranty") @db.VarChar(2000)
  specifications Json
  categoryId     String
  category       Category       @relation(fields: [categoryId], references: [id])
  brandId        String
  brand          Brand          @relation(fields: [brandId], references: [id])
  status         String         @default("ACTIVE")
  badge          String         @default("")
  featured       Boolean        @default(false)
  minPrice       Int            @default(0)
  ratingScore    Float          @default(0)
  reviewsCount   Int            @default(0)
  seoTitle       String         @default("")
  seoDescription String         @default("") @db.VarChar(300)
  createdAt      DateTime       @default(now())
  variants       Variant[]
  images         ProductImage[]
  reviews        Review[]
  wishlist       Wishlist[]

  @@index([categoryId, status])
  @@index([brandId, status])
  @@index([createdAt])
  @@index([minPrice])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String  @db.Text
  alt       String  @db.VarChar(255)
  position  Int     @default(0)
}

model Variant {
  id            String        @id @default(cuid())
  productId     String
  product       Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku           String        @unique
  color         String
  colorHex      String
  ram           String
  storage       String
  price         Int
  originalPrice Int
  stock         Int           @default(0)
  reserved      Int           @default(0)
  carts         CartItem[]
  orderItems    OrderItem[]
  reservations  Reservation[]

  @@index([price])
  @@index([ram, storage, price])
}

model CartItem {
  id        String  @id @default(cuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  variantId String
  variant   Variant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantity  Int

  @@unique([userId, variantId])
}

model Wishlist {
  id        String  @id @default(cuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
}

model Review {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  rating    Int
  text      String   @db.Text
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

model Order {
  id                String         @id @default(cuid())
  number            String         @unique
  userId            String
  user              User           @relation(fields: [userId], references: [id])
  address           Json
  subtotal          Int
  shipping          Int
  total             Int
  currency          String         @default("INR")
  status            String         @default("PENDING")
  paymentStatus     String         @default("PENDING")
  refundStatus      String         @default("NONE")
  refundReference   String?        @db.Text
  refundAmount      Int            @default(0)
  razorpayOrderId   String?        @unique
  checkoutKey       String         @unique
  tracking          String         @default("") @db.VarChar(500)
  inventoryConflict Boolean        @default(false)
  createdAt         DateTime       @default(now())
  items             OrderItem[]
  payments          Payment[]
  reservations      Reservation[]
  history           OrderHistory[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([paymentStatus, createdAt])
}

model OrderItem {
  id           String  @id @default(cuid())
  orderId      String
  order        Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId    String
  variant      Variant @relation(fields: [variantId], references: [id])
  title        String
  image        String  @db.Text
  variantLabel String  @db.Text
  quantity     Int
  price        Int
}

model Payment {
  id         String   @id @default(cuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id])
  providerId String   @unique
  amount     Int
  method     String
  status     String
  createdAt  DateTime @default(now())
}

model Reservation {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId String
  variant   Variant  @relation(fields: [variantId], references: [id])
  quantity  Int
  status    String   @default("ACTIVE")
  expiresAt DateTime

  @@index([status, expiresAt])
}

model OrderHistory {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    String
  note      String   @db.Text
  actorId   String?
  createdAt DateTime @default(now())
}

model WebhookEvent {
  id        String   @id
  createdAt DateTime @default(now())
}

model Newsletter {
  email     String   @id @db.VarChar(255)
  consentAt DateTime @default(now())
}

model Setting {
  key   String @id
  value Int
}

model RateLimit {
  key       String   @id @db.VarChar(512)
  count     Int      @default(1)
  expiresAt DateTime

  @@index([expiresAt])
}
